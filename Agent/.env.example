# 이 파일을 .env 로 복사해서 값만 채워 쓰세요. (.env 는 커밋하지 않습니다)

# Anthropic(Claude) API 키
ANTHROPIC_API_KEY=

# 백엔드 내부 API 호출용 공유 키
# 백엔드 application.yml 의 internal.service-key 와 반드시 같은 값
INTERNAL_SERVICE_KEY=

# 백엔드 주소 (기본값: http://localhost:8080)
BACKEND_BASE_URL=http://localhost:8080

# true 면 백엔드 없이 목업 데이터로 동작 (기본값: true)
# 실제 백엔드와 연결할 때는 false
USE_MOCK_SOT=false

# 사진 인식 모델(SigLIP2, 약 3.5GB) 적재 여부 — 1 = 적재, 0 = 적재 안 함 (기본값: 0)
LOAD_PHOTO_ENCODER=0

# 사진 모델 실행 장치 — auto / cpu / cuda (기본값: auto)
PHOTO_DEVICE=auto
