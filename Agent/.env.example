# 이 파일을 .env 로 복사해서 값만 채워 쓰세요. (.env 는 커밋하지 않습니다)

# Anthropic(Claude) API 키 — 없으면 일부 기능이 규칙 기반으로 대체됩니다
ANTHROPIC_API_KEY=

# 백엔드 내부 API 호출용 공유 키
# 백엔드 application.yml 의 internal.service-key 와 반드시 같은 값
INTERNAL_SERVICE_KEY=

# 실제 데이터 대신 목업 데이터를 쓸지 여부 (true / false)
USE_MOCK_SOT=false

# 사진 인코더 모델 로드 여부 (1 = 로드, 0 = 로드 안 함)
LOAD_PHOTO_ENCODER=1
