spring:
  # 09-06: 팀 공용 RDS(서울 리전)를 기본값으로 사용. 이 파일은 .gitignore에 있어서
  # (Backend/.gitignore:11) 저장소에 올라가지 않으므로 여기에 실제 값을 적어도 안전하다.
  # 로컬 docker DB로 되돌리려면: 아래 datasource 블록을 지우고 그 아래 주석 블록의
  # '#'을 지워서 살리면 된다 (두 블록을 맞바꾸는 방식).
  datasource:
    url: ${DB_URL:jdbc:mysql://storeflow-db.cveoe0ya0b0h.ap-northeast-2.rds.amazonaws.com:3306/storeflow_db}
    username: ${DB_USERNAME:admin}
    password: ${DB_PASSWORD:dowlwndwl1234!}
    driver-class-name: com.mysql.cj.jdbc.Driver

  # ── 로컬 docker (되돌릴 때 위 블록과 맞바꾼다) ──
  # datasource:
  #   url: ${DB_URL:jdbc:mysql://localhost:3307/storeflow_db}
  #   username: ${DB_USERNAME:root}
  #   password: ${DB_PASSWORD:1234}
  #   driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: none
    show-sql: true
    properties:
      hibernate:
        format_sql: true

#  h2:
#    console:
#      enabled: true       # http://localhost:8080/h2-console 에서 데이터 확인 가능
#      path: /h2-console

jwt:
  consumer-secret: change-this-to-a-real-secret-key-before-deploy-please
  consumer-access-expiration: 86400000      # 24시간 (ms)
  consumer-refresh-expiration: 1209600000  # 14일 (ms)

# Agent 서버(ai-server) 주소. /api/chat이 여기로 릴레이한다.
# Agent/app/config.py의 AGENT_PORT(하드코딩, 8000)에 실제로 맞춰뒀다 — 여기가 8100으로
# 남아있어서 Agent를 켜도 "AI 서버에 연결하지 못했어요"가 계속 떴던 것(포트 불일치).
agent:
  base-url: http://localhost:8000

# Agent(ai-server)가 /internal/cart 호출할 때 쓰는 공유 비밀키. Agent의 .env에도 같은 값 필요.
# 배포 전 반드시 실제 랜덤값으로 교체. 프론트에는 절대 노출 금지.
internal:
  service-key: change-this-shared-secret-before-deploy

# NAVER Cloud Platform SENS(SMS) 발송 설정. 실제 키가 없으면(로컬 DB/AI 연동 테스트 등)
# 더미 값으로 fallback해서 앱이 기동은 되게 한다 — 문자 인증 자체는 이 상태로는 실패한다.
ncp:
  sms:
    access-key: ${NCP_SMS_ACCESS_KEY:dummy-access-key}
    secret-key: ${NCP_SMS_SECRET_KEY:dummy-secret-key}
    service-id: ${NCP_SMS_SERVICE_ID:dummy-service-id}
    from: ${NCP_SMS_FROM:01000000000}

  object-storage:
    endpoint: ${NCP_OS_ENDPOINT:https://kr.object.ncloudstorage.com}
    region: ${NCP_OS_REGION:kr-standard}
    access-key: ${NCP_OS_ACCESS_KEY:dummy-access-key}
    secret-key: ${NCP_OS_SECRET_KEY:dummy-secret-key}
    bucket: ${NCP_OS_BUCKET:dummy-bucket}
