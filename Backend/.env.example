# 이 파일을 .env 로 복사해서 값만 채워 쓰세요. (.env 는 커밋하지 않습니다)

# ── AI ─────────────────────────────────────────
# Anthropic(Claude) API 키
ANTHROPIC_API_KEY=

# ── DB ─────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3307/storeflow_db
DB_USERNAME=root
DB_PASSWORD=

# ── 문자 발송 (네이버 클라우드 SENS, 선택) ──────
NCP_SMS_ACCESS_KEY=
NCP_SMS_SECRET_KEY=
NCP_SMS_SERVICE_ID=
# SENS 콘솔에 등록한 발신 번호 (숫자만)
NCP_SMS_FROM=
